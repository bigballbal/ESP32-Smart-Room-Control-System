#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <DHT.h>
#include <WiFi.h>
#include <WebServer.h>

#define AC_ON_TEMP 30
#define AC_OFF_TEMP 25

#define DHTPIN 4
#define DHTTYPE DHT11

typedef enum { MANUAL_MODE, AUTO_MODE } Mode;

typedef struct {
    Mode mode;
    int light;
    int temperature;
    int humidity;
    int ac;
} RoomSetting;

const char* ssid = "你的WiFi名稱";
const char* password = "你的WiFi密碼";

LiquidCrystal_I2C lcd(0x27, 16, 2);
DHT dht(DHTPIN, DHTTYPE);
WebServer server(80);

const int lightPin = 25;
const int acPin = 26;

RoomSetting myRoom = {MANUAL_MODE, 0, 25, 0, 0};

void runAutoControl() {
    if (myRoom.temperature > AC_ON_TEMP) {
        myRoom.ac = 1;
    } else if (myRoom.temperature < AC_OFF_TEMP) {
        myRoom.ac = 0;
    }
}

void renderHardware() {
    digitalWrite(lightPin, myRoom.light ? HIGH : LOW);
    digitalWrite(acPin, myRoom.ac ? HIGH : LOW);

    lcd.setCursor(0, 0);
    lcd.print("                ");
    lcd.setCursor(0, 0);

    lcd.print("T:");
    lcd.print(myRoom.temperature);
    lcd.print(" H:");
    lcd.print(myRoom.humidity);
    lcd.print(" A:");
    lcd.print(myRoom.ac ? "ON" : "OF");

    lcd.setCursor(15, 0);
    lcd.print(myRoom.mode == AUTO_MODE ? "A" : "M");
}

void readSensor() {
    float temp = dht.readTemperature();
    float hum = dht.readHumidity();

    if (!isnan(temp) && !isnan(hum)) {
        myRoom.temperature = (int)temp;
        myRoom.humidity = (int)hum;
    }
}

String htmlPage() {
    String modeText = myRoom.mode == AUTO_MODE ? "AUTO" : "MANUAL";
    String lightText = myRoom.light ? "ON" : "OFF";
    String acText = myRoom.ac ? "ON" : "OFF";

    String page = "";
    page += "<!DOCTYPE html><html><head>";
    page += "<meta name='viewport' content='width=device-width, initial-scale=1'>";
    page += "<meta http-equiv='refresh' content='3'>";
    page += "<style>";
    page += "body{font-family:Arial;text-align:center;background:#f4f4f4;padding:20px;}";
    page += ".card{background:white;padding:20px;border-radius:12px;max-width:360px;margin:auto;box-shadow:0 2px 8px #aaa;}";
    page += "button{font-size:18px;padding:12px 20px;margin:8px;border-radius:8px;border:0;background:#222;color:white;}";
    page += "</style></head><body>";
    page += "<div class='card'>";
    page += "<h2>ESP32 Smart Room</h2>";
    page += "<p>Temperature: " + String(myRoom.temperature) + " C</p>";
    page += "<p>Humidity: " + String(myRoom.humidity) + " %</p>";
    page += "<p>Mode: " + modeText + "</p>";
    page += "<p>Light: " + lightText + "</p>";
    page += "<p>AC: " + acText + "</p>";

    page += "<a href='/auto'><button>AUTO Mode</button></a>";
    page += "<a href='/manual'><button>MANUAL Mode</button></a><br>";
    page += "<a href='/light'><button>Toggle Light</button></a>";
    page += "<a href='/ac'><button>Toggle AC</button></a>";

    page += "</div></body></html>";
    return page;
}

void handleRoot() {
    server.send(200, "text/html", htmlPage());
}

void handleAuto() {
    myRoom.mode = AUTO_MODE;
    server.sendHeader("Location", "/");
    server.send(303);
}

void handleManual() {
    myRoom.mode = MANUAL_MODE;
    server.sendHeader("Location", "/");
    server.send(303);
}

void handleLight() {
    if (myRoom.mode == MANUAL_MODE) {
        myRoom.light = !myRoom.light;
    }
    server.sendHeader("Location", "/");
    server.send(303);
}

void handleAC() {
    if (myRoom.mode == MANUAL_MODE) {
        myRoom.ac = !myRoom.ac;
    }
    server.sendHeader("Location", "/");
    server.send(303);
}

void setup() {
    Serial.begin(115200);

    Wire.begin(21, 22);
    lcd.init();
    lcd.backlight();

    dht.begin();

    pinMode(lightPin, OUTPUT);
    pinMode(acPin, OUTPUT);

    lcd.setCursor(0, 0);
    lcd.print("Connecting WiFi");

    WiFi.begin(ssid, password);

    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
    }

    Serial.println();
    Serial.print("ESP32 IP: ");
    Serial.println(WiFi.localIP());

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("WiFi Connected");
    lcd.setCursor(0, 1);
    lcd.print(WiFi.localIP());

    server.on("/", handleRoot);
    server.on("/auto", handleAuto);
    server.on("/manual", handleManual);
    server.on("/light", handleLight);
    server.on("/ac", handleAC);
    server.begin();

    delay(3000);
    lcd.clear();
}

void loop() {
    static unsigned long lastRead = 0;

    if (millis() - lastRead > 2000) {
        readSensor();
        lastRead = millis();
    }

    if (myRoom.mode == AUTO_MODE) {
        runAutoControl();
    }

    renderHardware();
    server.handleClient();

    delay(100);
}
